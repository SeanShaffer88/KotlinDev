{
  "Compose Screen (stateful route + stateless content)": {
    "prefix": "comp-screen",
    "scope": "kotlin",
    "description": "Jetpack Compose screen: route collects StateFlow, content is stateless and previewable",
    "body": [
      "@Composable",
      "fun ${1:Feature}Route(viewModel: ${1:Feature}ViewModel = viewModel()) {",
      "    val state by viewModel.uiState.collectAsStateWithLifecycle()",
      "    ${1:Feature}Screen(state = state, onEvent = viewModel::onEvent)",
      "}",
      "",
      "@Composable",
      "fun ${1:Feature}Screen(state: ${1:Feature}UiState, onEvent: (${1:Feature}Event) -> Unit) {",
      "    Column(Modifier.fillMaxSize().padding(16.dp)) {",
      "        Text(text = state.${2:title}, style = MaterialTheme.typography.headlineMedium)",
      "        $0",
      "    }",
      "}",
      "",
      "@Preview(showBackground = true)",
      "@Composable",
      "private fun ${1:Feature}ScreenPreview() {",
      "    ${1:Feature}Screen(state = ${1:Feature}UiState(), onEvent = {})",
      "}"
    ]
  },
  "ViewModel with StateFlow (UDF)": {
    "prefix": "comp-viewmodel",
    "scope": "kotlin",
    "description": "ViewModel exposing a StateFlow UiState, updated only through onEvent",
    "body": [
      "data class ${1:Feature}UiState(val isLoading: Boolean = false, val ${2:items}: List<String> = emptyList(), val error: String? = null)",
      "",
      "sealed interface ${1:Feature}Event {",
      "    data object Refresh : ${1:Feature}Event",
      "}",
      "",
      "class ${1:Feature}ViewModel(private val repository: ${3:Repository}) : ViewModel() {",
      "    private val _uiState = MutableStateFlow(${1:Feature}UiState())",
      "    val uiState: StateFlow<${1:Feature}UiState> = _uiState.asStateFlow()",
      "",
      "    fun onEvent(event: ${1:Feature}Event) {",
      "        when (event) {",
      "            ${1:Feature}Event.Refresh -> refresh()",
      "        }",
      "    }",
      "",
      "    private fun refresh() = viewModelScope.launch {",
      "        _uiState.update { it.copy(isLoading = true, error = null) }",
      "        runCatching { repository.${4:load}() }",
      "            .onSuccess { data -> _uiState.update { it.copy(isLoading = false, ${2:items} = data) } }",
      "            .onFailure { e -> _uiState.update { it.copy(isLoading = false, error = e.message) } }",
      "    }",
      "    $0",
      "}"
    ]
  },
  "StateFlow declaration (in a class)": {
