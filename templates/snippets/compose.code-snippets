  "Compose Canvas Game Loop": {
    "prefix": "game-loop",
    "scope": "kotlin",
    "description": "Compose Canvas game loop: withFrameNanos drives update(dt), state held outside the draw scope (see docs/24)",
    "body": [
      "@Composable",
      "fun ${1:Game}Screen() {",
      "    var ballX by remember { mutableFloatStateOf(100f) }",
      "    var ballY by remember { mutableFloatStateOf(100f) }",
      "    var vx by remember { mutableFloatStateOf(220f) } // px per second",
      "    var vy by remember { mutableFloatStateOf(160f) }",
      "",
      "    LaunchedEffect(Unit) {",
      "        var last = withFrameNanos { it }",
      "        while (true) {",
      "            withFrameNanos { frame ->",
      "                val dt = ((frame - last) / 1_000_000_000f).coerceAtMost(0.033f) // clamp hitches",
      "                last = frame",
      "                ballX += vx * dt",
      "                ballY += vy * dt",
      "            }",
      "        }",
      "    }",
      "",
      "    Canvas(Modifier.fillMaxSize()) {",
      "        // bounce inside the field",
      "        if (ballX < 24f || ballX > size.width - 24f) vx = -vx",
      "        if (ballY < 24f || ballY > size.height - 24f) vy = -vy",
      "        drawCircle(color = Color(0xFF960018), radius = 24f, center = Offset(ballX, ballY))",
      "        $0",
      "    }",
      "}"
    ]
  }
}
